@host = http://localhost:5000
# Public demo (free tier: first request after idle can take ~1 min)
# @host = https://shorturl-davi.onrender.com

### Register (expect 201; auto-login)
# @name register
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "demo@example.com", "password": "Password123!" }

### Me with the register token (expect 200)
GET {{host}}/api/auth/me
Authorization: Bearer {{register.response.body.token}}

### Login (expect 200)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "demo@example.com", "password": "Password123!" }

### Me with the login token (expect 200)
GET {{host}}/api/auth/me
Authorization: Bearer {{login.response.body.token}}

### Duplicate register (expect 409)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "DEMO@example.com", "password": "Password123!" }

### Invalid login (expect 401)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "demo@example.com", "password": "WrongPassword123!" }

### Me without a token (expect 401)
GET {{host}}/api/auth/me

### Create an owned short URL (expect 201)
# @name create
POST {{host}}/api/urls
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "url": "https://dotnet.microsoft.com/en-us/learn", "customAlias": null, "expiresInDays": 30 }

### Create an owned URL with a custom alias (expect 201)
POST {{host}}/api/urls
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{ "url": "https://learn.microsoft.com/ef/core/", "customAlias": "ef-core", "expiresInDays": 7 }

### List my links (expect 200)
GET {{host}}/api/urls?page=1&pageSize=10
Authorization: Bearer {{login.response.body.token}}

### List without a token (expect 401)
GET {{host}}/api/urls

### List with invalid pagination (expect 400)
GET {{host}}/api/urls?page=0&pageSize=101
Authorization: Bearer {{login.response.body.token}}

### Redirect (expect 302; set code from the create response)
GET {{host}}/{{create.response.body.shortCode}}
Accept: text/html

### Stats (expect 200)
GET {{host}}/api/urls/{{create.response.body.shortCode}}

### Delete owned URL (expect 204)
DELETE {{host}}/api/urls/{{create.response.body.shortCode}}
Authorization: Bearer {{login.response.body.token}}

### Create an anonymous short URL (expect 201)
# @name anonymousCreate
POST {{host}}/api/urls
Content-Type: application/json

{ "url": "https://example.com/anonymous", "customAlias": null, "expiresInDays": 30 }

### Delete without a token (expect 401)
DELETE {{host}}/api/urls/{{anonymousCreate.response.body.shortCode}}

### Delete an anonymous link as an authenticated user (expect 403)
DELETE {{host}}/api/urls/{{anonymousCreate.response.body.shortCode}}
Authorization: Bearer {{login.response.body.token}}

### Delete a missing code with a token (expect 404)
DELETE {{host}}/api/urls/doesnotexist
Authorization: Bearer {{login.response.body.token}}

### Create with an invalid token (expect 401)
POST {{host}}/api/urls
Content-Type: application/json
Authorization: Bearer not-a-jwt

{ "url": "https://example.com/invalid-token", "customAlias": null, "expiresInDays": 30 }

### Delete with an invalid token (expect 401)
DELETE {{host}}/api/urls/anything
Authorization: Bearer not-a-jwt

### Liveness (expect 200, no database dependency)
GET {{host}}/health/live

### Readiness (expect 200, checks the database)
GET {{host}}/health

### Invalid URL (expect 400)
POST {{host}}/api/urls
Content-Type: application/json

{ "url": "not-a-url", "expiresInDays": 30 }

### Reserved alias (expect 400)
POST {{host}}/api/urls
Content-Type: application/json

{ "url": "https://example.com", "customAlias": "swagger", "expiresInDays": 30 }
