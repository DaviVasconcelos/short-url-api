{
  "ConnectionStrings": {
    "Default": "Data Source=shorturl.db",
    "Postgres": ""
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ShortUrl": {
    "CodeLength": 7,
    "DefaultExpiryDays": 30,
    "CacheTtlSeconds": 300
  },
  "Jwt": {
    "Issuer": "ShortUrl.Api",
    "Audience": "ShortUrl.Api",
    "ExpiryMinutes": 60
  },
  "Cleanup": {
    "Enabled": false,
    "IntervalMinutes": 60,
    "RetentionDays": 30,
    "BatchSize": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
