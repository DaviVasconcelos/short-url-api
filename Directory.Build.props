<Project>

  <!--
    Shared build settings for every project in the solution.
    TargetFramework stays in each .csproj on purpose: the runtime is pinned to net8.0
    while global.json pins the SDK used for tooling.
  -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Dependency vulnerability advisories must not fail a build on their own. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
