{
  "ConnectionStrings": {
    "Default": "Data Source=shorturl.db"
  },
  "ShortUrl": {
    "BaseUrl": "http://localhost:5000",
    "CodeLength": 7,
    "DefaultExpiryDays": 30,
    "CacheTtlSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
